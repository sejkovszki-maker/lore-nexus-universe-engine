{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://universe-engine.local/schemas/event/v1",
  "type": "object", "additionalProperties": false,
  "required": ["id", "universeId", "typeId", "names", "time", "locationEntityIds", "participants", "parentEventId", "status", "claimIds", "evidenceIds", "attributes"],
  "properties": {
    "id": { "type": "string" }, "universeId": { "type": "string" }, "typeId": { "type": "string" }, "names": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
    "time": { "type": "object" }, "locationEntityIds": { "type": "array", "items": { "type": "string" } },
    "participants": { "type": "array", "items": { "type": "object", "required": ["entityId", "role", "certainty"], "properties": { "entityId": { "type": "string" }, "role": { "type": "string" }, "certainty": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    "parentEventId": { "anyOf": [{ "type": "null" }, { "type": "string" }] }, "status": { "enum": ["staged", "validated", "accepted", "rejected"] },
    "claimIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "attributes": { "type": "object" }
  }
}
