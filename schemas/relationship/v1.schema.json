{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://universe-engine.local/schemas/relationship/v1",
  "type": "object", "additionalProperties": false,
  "required": ["id", "universeId", "typeId", "sourceEntityId", "targetEntityId", "direction", "status", "validity", "attributes", "claimIds", "evidenceIds", "createdAtUtc"],
  "properties": {
    "id": { "type": "string" }, "universeId": { "type": "string" }, "typeId": { "type": "string" }, "sourceEntityId": { "type": "string" }, "targetEntityId": { "type": "string" },
    "direction": { "enum": ["directed", "symmetric"] }, "status": { "enum": ["staged", "validated", "accepted", "rejected"] },
    "validity": { "type": "object", "required": ["start", "end"], "properties": { "start": {}, "end": {} } }, "attributes": { "type": "object" },
    "claimIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "createdAtUtc": { "type": "string", "format": "date-time" }
  }
}
