{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://universe-engine.local/schemas/claim/v1",
  "type": "object", "additionalProperties": false,
  "required": ["id", "universeId", "subjectEntityId", "predicate", "object", "polarity", "modality", "validFrom", "validTo", "uncertainty", "evidenceIds", "status", "createdAtUtc"],
  "properties": {
    "id": { "type": "string", "minLength": 1 }, "universeId": { "type": "string" }, "subjectEntityId": { "type": "string", "pattern": "^ent_[a-f0-9]{40}$" }, "predicate": { "type": "string", "minLength": 1 },
    "object": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["entity", "literal"] }, "entityId": { "type": "string" }, "value": {}, "dataType": { "type": "string" } } },
    "polarity": { "enum": ["affirmative", "negative"] }, "modality": { "enum": ["asserted", "possible", "probable", "counterfactual", "unknown"] },
    "validFrom": { "anyOf": [{ "type": "null" }, { "type": "string" }] }, "validTo": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
    "uncertainty": { "type": "object", "additionalProperties": false, "required": ["confidence", "lowerBound", "upperBound", "basis", "reasons"], "properties": { "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "lowerBound": { "type": "number", "minimum": 0, "maximum": 1 }, "upperBound": { "type": "number", "minimum": 0, "maximum": 1 }, "basis": { "enum": ["explicit-source", "extraction", "inference", "editorial"] }, "reasons": { "type": "array", "items": { "type": "string" } } } },
    "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "status": { "enum": ["staged", "validated", "accepted", "rejected", "superseded"] }, "createdAtUtc": { "type": "string", "format": "date-time" }
  }
}
